# Copier vers .env.prod (production, branche main) ou .env.dev (test, branche dev) sur le serveur.
# JAMAIS commité (déjà dans .gitignore). Générer chaque secret : openssl rand -hex 32

# Domaine pointant vers le VPS (enregistrement DNS A), sans https://
DOMAIN=crm.example.com

# Port local (127.0.0.1 uniquement). Production : 3020. Test (dev) : 3120.
WEB_PORT=3020

POSTGRES_PASSWORD=

# Premier administrateur, créé au premier démarrage seulement (mot de passe : 12 caractères minimum).
# Après la première connexion, changez le mot de passe dans « Mon profil ».
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Facultatif
# LOG_LEVEL=info
# SLOW_REQUEST_MS=1000
# POSTGRES_MEM=1g
# API_MEM=384m
# WEB_MEM=128m
