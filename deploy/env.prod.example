# Copier vers .env.prod (production, branche main) ou .env.dev (test, branche dev) sur le serveur.
# JAMAIS commité (déjà dans .gitignore). Générer chaque secret : openssl rand -hex 32

# Domaine pointant vers le VPS (enregistrement DNS A), sans https://
DOMAIN=crm.example.com

# Port local (127.0.0.1 uniquement). Production : 3020. Test (dev) : 3120.
WEB_PORT=3020

POSTGRES_PASSWORD=

# Premier administrateur, créé au premier démarrage seulement (mot de passe : 12 caractères minimum).
# Après la première connexion, changez le mot de passe dans « Mon profil ».
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Gabarit des e-mails de prospection (facultatif ; vide = valeurs historiques). \n = saut de ligne.
# MAIL_FROM_NAME=
# MAIL_FROM_ADDRESS=
# MAIL_AGENDA_TEXT=
# MAIL_SIGNATURE=

# Envoi des e-mails par Brevo (voir docs/12-envoi-brevo.md). Désactivé tant que SEND_MODE n'est pas « prod ».
# Les valeurs secrètes se mettent ICI, sur le serveur (ou dans les secrets GitHub), jamais dans le dépôt ni dans une discussion.
# SEND_MODE=off
# BREVO_API_KEY=
# BREVO_WEBHOOK_SECRET=      (24 caractères minimum, aléatoire : openssl rand -hex 24)
# UNSUBSCRIBE_SECRET=        (32 caractères minimum, aléatoire : openssl rand -hex 32)
# SEND_TEST_RECIPIENT=       (votre propre adresse, pour les e-mails de test)
# MAIL_FROM_ADDRESS=         (obligatoire en mode prod : expéditeur vérifié chez Brevo)
# MAIL_OPTOUT_TEXT=
# SEND_DAILY_CAP=50
# SEND_INTERVAL_SECONDS=45
# SEND_SLOTS=mon@14:00,tue@09:00,wed@09:00,thu@09:00
# SEND_WINDOW_MINUTES=120

# Facultatif
# LOG_LEVEL=info
# SLOW_REQUEST_MS=1000
# POSTGRES_MEM=1g
# API_MEM=384m
# WEB_MEM=128m
