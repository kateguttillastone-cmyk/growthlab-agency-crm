# Développement local : copier vers apps/api/.env (chargé par `pnpm dev:api`). Jamais commité.
# Base : docker compose up -d postgres   (ou toute base PostgreSQL 16+)
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://gac:gac@localhost:5432/gac

# Origine du front en développement (Vite). En production : https://<domaine>
APP_ORIGIN=http://localhost:5173

# Premier administrateur, créé au démarrage s'il n'existe pas (mot de passe : 12 caractères minimum)
SEED_ADMIN_EMAIL=admin@gac.local
SEED_ADMIN_PASSWORD=ChangeMe-Please-123

# Documentation OpenAPI sur http://localhost:3001/docs (désactivée par défaut, jamais en production)
SWAGGER=true
LOG_PRETTY=true
