{
  "name": "gac-pilot",
  "private": true,
  "version": "0.1.0",
  "description": "GAC Pilot — CRM de prospection de GrowthLab Agency",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @gac/api dev",
    "dev:web": "pnpm --filter @gac/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @gac/api db:generate",
    "db:migrate": "pnpm --filter @gac/api db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "~5.9.3"
  }
}
